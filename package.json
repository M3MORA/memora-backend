{
  "name": "api-gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:gateway": "nest start api-gateway",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:iam": "npm run prisma:iam:generate && nest start iam-service",
    "start:iam:dev": "npm run prisma:iam:generate && nest start iam-service --watch",
    "build:iam": "npm run prisma:iam:generate && nest build iam-service",
    "prisma:iam:validate": "prisma validate --config apps/iam-service/prisma.config.ts",
    "prisma:iam:generate": "prisma generate --config apps/iam-service/prisma.config.ts",
    "prisma:iam:migrate:dev": "prisma migrate dev --config apps/iam-service/prisma.config.ts",
    "prisma:iam:migrate:deploy": "prisma migrate deploy --config apps/iam-service/prisma.config.ts",
    "prisma:iam:seed": "prisma db seed --config apps/iam-service/prisma.config.ts",
    "prisma:iam:bootstrap": "npm run prisma:iam:migrate:deploy && npm run prisma:iam:seed",
    "iam:rbac-v1:validate": "node validate-rbac-v1.cjs",
    "iam:rbac-v1:dry-run": "npx tsx apps/iam-service/prisma/rbac-v1-bootstrap.ts",
    "iam:rbac-v1:apply": "npx tsx apps/iam-service/prisma/rbac-v1-bootstrap.ts --apply",
    "kit:validate": "node .cursor/scripts/validate-kit.cjs",
    "boundaries": "node .cursor/scripts/check-boundaries.cjs --all",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proto:check": "node scripts/ci/check-protos.cjs",
    "ci:audit": "node scripts/ci/npm-audit-gate.cjs",
    "ci:secrets": "node scripts/ci/deny-tracked-secrets.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "google-auth-library": "^10.9.1",
    "hash-wasm": "^4.12.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/auth/google-oauth$": "<rootDir>/libs/auth/google-oauth/src/index.ts",
      "^@app/auth/google-oauth/(.*)$": "<rootDir>/libs/auth/google-oauth/src/$1",
      "^@app/auth(|/.*)$": "<rootDir>/libs/auth/authorization/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1",
      "^@app/cache(|/.*)$": "<rootDir>/libs/cache/src/$1",
      "^@app/queue(|/.*)$": "<rootDir>/libs/queue/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
