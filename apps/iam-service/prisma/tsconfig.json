{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "./seed.ts",
    "./system-roles.ts",
    "./approved-permissions.ts",
    "./rbac-v1-bootstrap.ts",
    "../generated/prisma/**/*.ts"
  ]
}
