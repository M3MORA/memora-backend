generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["iam"]
  extensions = [citext(schema: "public")]
}

/// IAM auth account.
/// SQL (migration, not Prisma):
/// - CHECK auth_provider IN ('LOCAL', 'GOOGLE', 'HYBRID')
/// - CHECK status IN ('ACTIVE', 'LOCKED', 'DISABLED')
/// - TRIGGER updated_at = now() on UPDATE
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  email           String    @unique @map("email") @db.Citext
  passwordHash    String?   @map("password_hash") @db.Text
  authProvider    String    @default("LOCAL") @map("auth_provider") @db.VarChar(20)
  googleSub       String?   @unique @map("google_sub") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(150)
  phone           String?   @map("phone") @db.VarChar(30)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  status          String    @default("ACTIVE") @map("status") @db.VarChar(20)
  termsVersion    String?   @map("terms_version") @db.VarChar(50)
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy              User?              @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  createdUsers           User[]             @relation("UserCreatedBy")
  customerIdentities     CustomerIdentity[]
  userRoles              UserRole[]         @relation("UserRoleAssignments")
  assignedUserRoles      UserRole[]         @relation("UserRoleAssignedBy")
  grantedRolePermissions RolePermission[]   @relation("RolePermissionGrantedBy")

  @@map("users")
  @@schema("iam")
}

/// Guest customer may exist without a User (user_id nullable).
/// contact_email is NOT globally unique — identities are not merged by email/phone.
/// SQL (migration, not Prisma):
/// - PARTIAL UNIQUE (user_id) WHERE is_primary_for_user = true AND user_id IS NOT NULL
/// - CHECK (is_primary_for_user = false OR user_id IS NOT NULL)
/// - TRIGGER updated_at = now() on UPDATE
/// - CHECK status values: not finalized in tracker
model CustomerIdentity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  isPrimaryForUser Boolean   @default(false) @map("is_primary_for_user")
  displayName      String?   @map("display_name") @db.VarChar(150)
  contactEmail     String    @map("contact_email") @db.Citext
  contactPhone     String?   @map("contact_phone") @db.VarChar(30)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt  DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  accountLinkedAt  DateTime? @map("account_linked_at") @db.Timestamptz(6)
  status           String    @default("ACTIVE") @map("status") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("customer_identities")
  @@schema("iam")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code        String   @unique @map("code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(100)
  description String?  @map("description") @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code        String   @unique @map("code") @db.VarChar(80)
  name        String   @map("name") @db.VarChar(120)
  description String?  @map("description") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

/// Junction with audit history (surrogate UUID PK, not composite PK).
/// SQL (migration, not Prisma):
/// - PARTIAL UNIQUE (user_id, role_id) WHERE revoked_at IS NULL
model UserRole {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.Text

  user       User  @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("user_roles")
  @@schema("iam")
}

/// Junction with grant audit (surrogate UUID PK, not composite PK).
/// No revoke history: UNIQUE (role_id, permission_id) is applied in migration SQL.
model RolePermission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  permissionId    String   @map("permission_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("role_permissions")
  @@schema("iam")
}

/// Durable one-time RBAC bootstrap marker. Deleting a grant after apply must not
/// cause a later apply of the same key/checksum to recreate it.
model RbacBootstrapExecution {
  key            String   @id @map("key") @db.VarChar(80)
  grantsChecksum String   @map("grants_checksum") @db.VarChar(64)
  grantsInserted Int      @map("grants_inserted")
  appliedAt      DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  appliedBy      String?  @map("applied_by") @db.VarChar(200)

  @@map("rbac_bootstrap_executions")
  @@schema("iam")
}
