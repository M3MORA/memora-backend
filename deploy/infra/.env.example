# Copied to /opt/memora/secrets/infra.env by the host helper (never commit real values).
POSTGRES_USER=memora
POSTGRES_PASSWORD=replace-with-csprng-postgres-password
POSTGRES_DB=memora
REDIS_PASSWORD=replace-with-csprng-redis-password-min-16

