# /etc/sudoers.d/memora-deploy
# visudo -c -f this file before installing.
# Grants a single binary, not NOPASSWD: ALL.
# The helper validates subcommands and image digests internally.

Defaults:runner-memora-backend env_reset
# Replace RUNNER_OS_USER with the account that runs GitHub Actions
# (ps aux | grep Runner.Listener). Example: github-runner or runner-memora-backend.
RUNNER_OS_USER ALL=(root) NOPASSWD: /opt/memora/bin/memora-deploy
