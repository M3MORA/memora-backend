NODE_ENV=production
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=50051
IAM_HEALTH_HOST=0.0.0.0
IAM_HEALTH_PORT=5051
IAM_DATABASE_URL=postgresql://memora:replace-with-postgres-password@postgres:5432/memora?schema=iam
IAM_JWT_SECRET=replace-with-32-plus-char-jwt-secret
IAM_INTERNAL_GRPC_SECRET=replace-with-32-plus-char-shared-grpc-secret
IAM_JWT_ISSUER=memora-iam
IAM_JWT_AUDIENCE=memora-api
IAM_JWT_ACCESS_TTL_SECONDS=900
IAM_REDIS_HOST=redis
IAM_REDIS_PORT=6379
IAM_REDIS_PASSWORD=replace-with-redis-password-min-16
IAM_REDIS_DB=0
IAM_REFRESH_PEPPER=replace-with-32-plus-char-refresh-pepper
IAM_REFRESH_IDLE_TTL_SECONDS=604800
IAM_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
IAM_REFRESH_REUSE_GRACE_SECONDS=10
IAM_PURPOSE_TOKEN_PEPPER=replace-with-32-plus-char-purpose-pepper
IAM_EMAIL_ACTION_BASE_URL=https://replace-with-frontend-origin
IAM_EMAIL_VERIFICATION_TTL_SECONDS=86400
IAM_EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
IAM_PASSWORD_RESET_TTL_SECONDS=1800
IAM_PASSWORD_RESET_COOLDOWN_SECONDS=60
IAM_EMAIL_RATE_LIMIT_MAX=5
IAM_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
# GOOGLE_CLIENT_ID=
