{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/auth": ["libs/auth/authorization/src/index.ts"],
      "@app/auth/google-oauth": ["libs/auth/google-oauth/src/index.ts"],
      "@app/auth/*": ["libs/auth/authorization/src/*"],
      "@app/common": ["libs/common/src/index.ts"],
      "@app/common/*": ["libs/common/src/*"],
      "@app/config": ["libs/config/src/index.ts"],
      "@app/config/*": ["libs/config/src/*"],
      "@app/contracts": ["libs/contracts/src/index.ts"],
      "@app/contracts/*": ["libs/contracts/src/*"],
      "@app/observability": ["libs/observability/src/index.ts"],
      "@app/observability/*": ["libs/observability/src/*"],
      "@app/cache": ["libs/cache/src/index.ts"],
      "@app/cache/*": ["libs/cache/src/*"],
      "@app/queue": ["libs/queue/src/index.ts"],
      "@app/queue/*": ["libs/queue/src/*"]
    }
  }
}
